# mock runs offline. Set openai to call any OpenAI-compatible chat endpoint.
BRIEFWRIGHT_LLM_BACKEND=mock
BRIEFWRIGHT_OPENAI_API_KEY=
BRIEFWRIGHT_OPENAI_BASE_URL=https://api.openai.com/v1
BRIEFWRIGHT_OPENAI_MODEL=gpt-4o-mini
BRIEFWRIGHT_MAX_REVISIONS=2
BRIEFWRIGHT_SCORE_THRESHOLD=0.75
BRIEFWRIGHT_MEMORY_PATH=data/memory.json
# Leave empty to use the committed SciFact sample. Set this to a directory
# produced by scripts/download_scifact.py if you build a larger index.
BRIEFWRIGHT_CORPUS_DIR=
